# ── Department identity ───────────────────────────────────────────────────────
# Set these in Vercel → Project Settings → Environment Variables
# They are baked into the frontend at build time (Vite VITE_* prefix required)

# Short abbreviation shown in the header and nav labels (e.g. E&I / M&E / Civil)
VITE_DEPT_ABBR=E&I

# Full department name used in page titles and dashboard (e.g. E & I / Mechanical)
VITE_DEPT_NAME=E & I

# Company / entity name shown in the dashboard greeting and footer
VITE_COMPANY_NAME=Glass Technology (MENA) L.L.C

# Location shown in the dashboard greeting
VITE_COMPANY_LOC=Sharjah, UAE

# ── Backend URL ───────────────────────────────────────────────────────────────
# Your own Render backend URL (each department deploys their own backend)
VITE_API_URL=https://your-render-backend.onrender.com
